# Waraq Community configuration. Copy to .env and fill in SESSION_SECRET.

# Required. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The exact public origin users open in the browser, without a trailing slash.
# Used for cookies, CSRF/Origin checks, share links and the Google redirect URI.
PUBLIC_BASE_URL=http://localhost:3000

# All persistent state (SQLite database, PDFs, render cache). Docker Compose sets /app/data.
DATA_DIR=./data

# Optional. Separate Better Auth secret; derived from SESSION_SECRET when empty.
BETTER_AUTH_SECRET=

# Optional Google OAuth client (see docs/GOOGLE-OAUTH.md). Enables linking Google sign-in to the owner and the
# Google Drive mirror. Leave both empty for local-only operation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Reverse proxy networks to trust for X-Forwarded-For, comma separated CIDRs.
# Loopback is always trusted. Use the keyword "cloudflare" when Cloudflare proxies your domain.
TRUSTED_PROXY_CIDRS=

# Optional OCR tuning. WARAQ_OCR_LANGS overrides the language order chosen in Settings (for example ara+eng).
WARAQ_OCR_LANGS=
WARAQ_OCR_JOBS=
WARAQ_TESSDATA_DIR=

# Optional. Time zone for default document titles ("Scan 2026-01-31 14:05"). Defaults to the server time zone.
WARAQ_TZ=

HOSTNAME=0.0.0.0
PORT=3000
NODE_ENV=production
